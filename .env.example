# Copia este archivo a .env y rellena los valores.
# El .env real está en .gitignore: nunca se sube al repo.
#
# En producción estas variables las inyecta Railway desde su dashboard,
# no salen de este archivo.
#
# Son claves PÚBLICAS del cliente (van embebidas en el bundle del frontend).
# La protección real es RLS en Supabase. Nunca pongas aquí la service_role key
# ni tokens de Twilio/Anthropic: esos viven en los secrets de Edge Functions.

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
